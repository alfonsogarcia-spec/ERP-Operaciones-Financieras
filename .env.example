# Puerto del servidor (por defecto 4174)
PORT=4174

# Secreto para firmar los JWT. DEFÍNELO en producción (cadena larga y aleatoria).
JWT_SECRET=

# Base de datos Postgres (Supabase). Puede ser el MISMO proyecto que gestion-operaciones:
# el aislamiento se logra con un SCHEMA dedicado (ver DB_SCHEMA), no con otra base.
# Si NO se define, el servidor usa pglite local (./.pgdata) para desarrollo.
# Usa la cadena "Session/Direct" (no la de Transaction pooler), porque fijamos search_path.
# Ejemplo Supabase: postgresql://postgres:CONTRASENA@db.XXXX.supabase.co:5432/postgres
DATABASE_URL=

# Schema donde viven TODAS las tablas de este sistema (aislado de public). Por defecto: conciliacion
DB_SCHEMA=conciliacion

# Google Sign-In: Client ID de OAuth 2.0 (Google Cloud Console → APIs y Servicios → Credenciales).
# En "Orígenes de JavaScript autorizados" agrega:
#   http://localhost:4174
#   https://polipay-conciliacion-liquidacion.onrender.com
# Formato: XXXXXXXXXX-XXXXXXXX.apps.googleusercontent.com
GOOGLE_CLIENT_ID=

# AWS SES para el envío de correos (Notificación de corte).
# Rol IAM mínimo: ses:SendRawEmail + ses:SendEmail.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
