# Copia a .env solo para desarrollo local. En Render estas variables se capturan en el dashboard.
# Sin DATABASE_URL se usa pglite (Postgres local en ./.pgdata). Sin GOOGLE_CLIENT_ID entra en modo desarrollo (sin login).
DATABASE_URL=
OFICINA_SCHEMA=oficina
JWT_SECRET=
GOOGLE_CLIENT_ID=
ALLOWED_HD=polipay.io
OFICINA_ADMINS=
PORT=3100
